{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "proxy": {
    "entrypoint": "proxy.ts",
    "matcher": ["/chat/:path*", "/settings/:path*", "/knowledge-base/:path*"]
  },
  "rewrites": [
    {
      "source": "/((?!api/|src/|node_modules/|@).*)",
      "destination": "/index.html"
    }
  ]
}
